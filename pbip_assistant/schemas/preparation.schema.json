    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "action": {
          "const": "undo",
          "type": "string"
        },
        "preparationId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "pointId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedCursor": {
