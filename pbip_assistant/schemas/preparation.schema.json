        },
        "preparationId": {
          "$ref": "#/$defs/identifier"
        },
        "reviewHash": {
          "$ref": "#/$defs/fingerprint"
        },
        "kind": {
          "enum": [
            "import",
            "cleanup"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "preparationId",
        "reviewHash",
        "kind",
        "target"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "action": {
          "const": "begin",
          "type": "string"
        },
        "preparationId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "grantId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedPreservationFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "preparationId",
        "expectedFingerprint",
        "grantId",
        "expectedPreservationFingerprint"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "action": {
          "const": "write-ready",
          "type": "string"
        },
        "preparationId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedFingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "attemptId": {
          "$ref": "#/$defs/identifier"
        },
        "beforeImageId": {
          "$ref": "#/$defs/identifier"
        },
        "expectedPreservationFingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "preparationId",
        "expectedFingerprint",
        "attemptId",
        "beforeImageId",
        "expectedPreservationFingerprint"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "integer"
        },
        "action": {
          "const": "complete",
          "type": "string"
        },
        "preparationId": {
          "$ref": "#/$defs/identifier"
        },
        "attemptId": {
          "$ref": "#/$defs/identifier"
        },
        "receipt": {
          "$ref": "#/$defs/receipt"
