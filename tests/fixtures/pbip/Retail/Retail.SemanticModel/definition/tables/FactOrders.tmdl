table FactOrders

	column OrderID
		dataType: string
		sourceColumn: OrderID
		summarizeBy: none

	column CustomerID
		dataType: string
		sourceColumn: CustomerID
		summarizeBy: none

	column ProductID
		dataType: string
		sourceColumn: ProductID
		summarizeBy: none

	column OrderDate
		dataType: dateTime
		sourceColumn: OrderDate
		summarizeBy: none

	column Quantity
		dataType: int64
		sourceColumn: Quantity
		summarizeBy: none

	column UnitPrice
		dataType: double
		sourceColumn: UnitPrice
		summarizeBy: none

	column Discount
		dataType: double
		sourceColumn: Discount
		summarizeBy: none

	column Status
		dataType: string
		sourceColumn: Status
		summarizeBy: none

	/// Synthetic gross sales; not net sales.
	measure 'Gross Sales' = SUMX(FactOrders, FactOrders[Quantity] * FactOrders[UnitPrice])
		formatString: "#,0.00"

	measure 'Order Count' = DISTINCTCOUNT(FactOrders[OrderID])
		formatString: "#,0"

	partition FactOrders = m
		mode: import
		source =
			#table(type table [OrderID = text, CustomerID = text, ProductID = text, OrderDate = datetime, Quantity = number, UnitPrice = number, Discount = number, Status = text], {{"TEST-001", "C-001", "P-01", #datetime(2026, 9, 1, 0, 0, 0), 2, 100.0, 10.0, "Completed"}})
