                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "passed": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rateActual": {
              "anyOf": [
                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rateBudget": {
              "anyOf": [
                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
