                {
                  "type": "null"
                }
              ]
            },
            "actualVnd": {
              "anyOf": [
                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "applicable": {
              "type": "boolean"
            },
            "budgetUsd": {
              "anyOf": [
                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "budgetVnd": {
              "anyOf": [
                {
                  "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$",
