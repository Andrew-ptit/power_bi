    "blockers": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "AF_INGEST_FAILED",
              "AF_SOURCE_LOST",
              "AF_FANOUT_RISK",
              "AF_MISSING_DATA",
              "AF_RECONCILE_FAILED",
              "AF_SPEC_STALE",
              "AF_WRITE_PARTIAL"
            ]
          },
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "warning"
            ]
          }
        },
        "required": [
          "code",
          "severity",
          "message"
        ],
        "type": "object"
      },
      "minItems": 0,
      "type": "array"
    },
    "bridge": {
      "oneOf": [
