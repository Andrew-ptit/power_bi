        },
        "pack": {
          "additionalProperties": false,
          "properties": {
            "genericMode": {
              "type": "boolean"
            },
            "id": {
              "type": "string"
            },
            "notice": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "version",
            "genericMode",
            "notice"
          ],
          "type": "object"
        },
        "passed": {
          "type": "boolean"
        },
        "relationships": {
          "items": {
            "$ref": "#/$defs/relationship"
          },
          "minItems": 1,
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/role"
          },
          "minItems": 1,
