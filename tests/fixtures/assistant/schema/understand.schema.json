        "understandHash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "variantOf": {
          "type": [
            "string",
            "null"
          ]
        },
        "variantReason": {
          "type": [
            "string",
            "null"
          ]
        },
        "warnings": {
          "items": {
            "$ref": "#/$defs/warning"
          },
          "minItems": 0,
          "type": "array"
        }
      },
      "required": [
        "schemaVersion",
        "snapshotHash",
        "pack",
        "roles",
        "relationships",
        "assumptions",
        "warnings",
        "hashBasis",
        "understandHash",
        "variantOf",
        "variantReason"
      ],
      "type": "object"
    },
    {
