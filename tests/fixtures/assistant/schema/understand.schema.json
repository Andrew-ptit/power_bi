          "minItems": 1,
          "type": "array"
        },
        "hashBasis": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "pack": {
          "additionalProperties": false,
          "properties": {
            "genericMode": {
