            },
            "id": {
              "type": "string"
            },
            "notice": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "id",
